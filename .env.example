# ===== JR Sound — variáveis de ambiente =====
# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Firebase (veja TUTORIAL-FIREBASE.md, Passo 5).
#
# SEM estas variáveis o site roda em modo local (produtos no navegador),
# ideal para desenvolvimento.

NEXT_PUBLIC_FB_API_KEY=
NEXT_PUBLIC_FB_AUTH_DOMAIN=
NEXT_PUBLIC_FB_PROJECT_ID=
NEXT_PUBLIC_FB_APP_ID=
