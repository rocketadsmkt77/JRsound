rules_version = '2';

// Regras do Firestore:
// - qualquer visitante pode LER os produtos (o configurador precisa disso)
// - só usuários logados (o administrador criado no Firebase Authentication)
//   podem criar, editar ou excluir
service cloud.firestore {
  match /databases/{database}/documents {
    match /produtos/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // contador de visitas: qualquer visitante soma +1; só aceita os
    // campos do contador, nada além disso
    match /estatisticas/{pagina} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['visitas', 'atualizadoEm'])
        && request.resource.data.visitas is int;
      allow delete: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
