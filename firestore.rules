rules_version = '2';

// Regras do Firestore:
// - qualquer visitante pode LER os produtos (o configurador precisa disso)
// - só usuários logados (o administrador criado no Firebase Authentication)
//   podem criar, editar ou excluir
service cloud.firestore {
  match /databases/{database}/documents {
    match /produtos/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
